{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["token", "user"],
  "properties": {
    "token": { "type": "string" },
    "user": {
      "type": "object",
      "required": ["id", "name", "email", "role", "status"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  }
}
